rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Counters collection for atomic sequential numbering
    match /counters/{counterId} {
      allow read, write: if true;
    }
  }
}
